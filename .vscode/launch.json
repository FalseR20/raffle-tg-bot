{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Bot: run",
      "type": "debugpy",
      "request": "launch",
      "module": "bot.main",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONUNBUFFERED": "1"
      },
      "console": "integratedTerminal",
      "justMyCode": false,
      "preLaunchTask": "setup: local dependencies"
    },
    {
      "name": "Bot: run (no debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "bot.main",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONUNBUFFERED": "1"
      },
      "console": "integratedTerminal",
      "noDebug": true,
      "preLaunchTask": "setup: local dependencies"
    },
    {
      "name": "Tests: pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false,
      "preLaunchTask": "setup: local dependencies"
    },
    {
      "name": "Tests: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q", "${file}"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false,
      "preLaunchTask": "setup: local dependencies"
    },
    {
      "name": "Alembic: upgrade head",
      "type": "debugpy",
      "request": "launch",
      "module": "alembic",
      "args": ["upgrade", "head"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false,
      "preLaunchTask": "setup: database only"
    }
  ]
}

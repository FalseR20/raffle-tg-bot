# ---- Telegram ----
BOT_TOKEN=123456:replace-me
ADMIN_IDS=123456789
WEBHOOK_URL=
WEBHOOK_SECRET=

# ---- PostgreSQL 15+ (asyncpg only) ----
DATABASE_URL=postgresql+asyncpg://raffle:raffle@localhost:5433/raffle
POSTGRES_DB=raffle
POSTGRES_USER=raffle
POSTGRES_PASSWORD=raffle
POSTGRES_PORT=5433

# ---- RustFS (private S3-compatible storage) ----
RUSTFS_ENDPOINT=http://localhost:9010
RUSTFS_ACCESS_KEY=raffle-minio
RUSTFS_SECRET_KEY=raffle-minio-secret
RUSTFS_BUCKET=raffle-receipts
RUSTFS_REGION=us-east-1
RUSTFS_USE_SSL=false
RUSTFS_FORCE_PATH_STYLE=true
RUSTFS_PORT=9010
RUSTFS_CONSOLE_PORT=9011

# ---- Product defaults ----
TZ=Europe/Minsk
DEFAULT_TICKET_PRICE=5.00
DEFAULT_MIN_AMOUNT=5.00
MAX_DONATION=10000.00
RECEIPT_MAX_MB=20
RECEIPT_RETENTION_DAYS=90
CHANNEL_URL=https://t.me/example_channel
CHANNEL_TITLE=Тетрадь с полями🪶
RULES_URL=https://example.org/rules
PRIVACY_URL=https://example.org/privacy
SUPPORT_CONTACT=@support
MANAGEMENT_LOG_CHAT_ID=
ENABLE_RANDOM_DRAW=false
CONFIRM_TWO_STEP=true
REQUIRE_AGE_CONFIRMATION=false

# ---- Runtime / tests ----
LOG_LEVEL=INFO
TEST_DATABASE_URL=postgresql+asyncpg://raffle:raffle@localhost:5433/raffle_test
TEST_RUSTFS_ENDPOINT=http://localhost:9010
TEST_RUSTFS_ACCESS_KEY=raffle-minio
TEST_RUSTFS_SECRET_KEY=raffle-minio-secret
TEST_RUSTFS_BUCKET=raffle-test-receipts
